  "status": "template",
  "frontendTenant": "<TENANT_ID>",
  "network": {
    "chainId": 84532
  },
  "secretsEnv": {
    "deployerPrivateKey": "TENANT_DEPLOYER_PRIVATE_KEY",
    "keeperPrivateKey": "TENANT_KEEPER_PRIVATE_KEY",
    "rpcUrl": "BASE_SEPOLIA_RPC_URL"
  },
  "roles": {
    "admin": "<ADMIN_MULTISIG_ADDRESS>",
    "risk": "<RISK_ADDRESS>",
    "guardian": "<GUARDIAN_ADDRESS>",
    "keeper": "<KEEPER_ADDRESS>",
    "marketOperator": "<MARKET_OPERATOR_ADDRESS>",
    "treasury": "<TENANT_TREASURY_ADDRESS>"
  },
  "shared": {
    "settlementToken": "<SETTLEMENT_TOKEN_ADDRESS>",
    "priceSource": "<REFERENCE_PRICE_SOURCE_ADDRESS>"
  },
