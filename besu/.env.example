# besu/.env.example —— 複製成 besu/.env 後修改（.env 已被 gitignore）。
# docker compose（-f besu/docker-compose.yml，專案目錄即 besu/）與 scripts/gen-network.mjs 都讀這個檔；環境變數優先於檔案內容。
# 這裡沒有、也不應該放任何私鑰。

# Besu 映像檔（釘選確切版本，不用 latest）
BESU_IMAGE=hyperledger/besu:26.9.0@sha256:fc1813d67d630d7660eea6ee555c01e73bfecda3e54d24f9484c1c4a52c6fcb0

# ── 寫進 genesis 的參數（改了要 `npm --prefix besu run gen -- --force` + `docker compose -p pepelab-besu -f besu/docker-compose.yml down -v`）──
BESU_CHAIN_ID=1337
# 驗證者數量：4（預設）或 1（低記憶體單節點開發模式；只啟動 node1，沒有拜占庭容錯）
BESU_VALIDATORS=4
# QBFT blockperiodseconds：最短出塊間隔（秒）
BESU_BLOCK_PERIOD=2
# QBFT requesttimeoutseconds：一輪共識逾時換輪（秒），必須大於出塊間隔；預設 2 × BLOCK_PERIOD
# BESU_REQUEST_TIMEOUT=4
BESU_EPOCH_LENGTH=30000
BESU_GAS_LIMIT=1000000000
# docker 網段前三碼（節點固定 IP .11–.14）；跟本機其他網路衝突時再改
BESU_SUBNET_PREFIX=10.233.66

# ── 只影響容器啟動的參數（改了 `docker compose -p pepelab-besu -f besu/docker-compose.yml up -d` 即可）──
# node1 JSON-RPC 映射到主機 127.0.0.1 的哪個埠
BESU_RPC_PORT=8545
BESU_JAVA_OPTS=-Xms64m -Xmx320m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=64m -XX:+UseSerialGC
# 每個節點容器的記憶體硬上限
BESU_MEM_LIMIT=768m
BESU_LOG_LEVEL=INFO
BESU_RPC_MAX_CONNECTIONS=400
