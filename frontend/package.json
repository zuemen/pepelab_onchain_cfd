{
  "name": "@minimal-kit/starter-vite-ts",
  "author": "Minimals",
  "version": "7.5.0",
  "description": "Vite Starter & TypeScript",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "tsc && vite build",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:print": "npx eslint --print-config eslint.config.mjs > eslint-show-config.json",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "npm run lint:fix && npm run fm:fix",
    "clean": "rm -rf node_modules .next out dist build",
    "re:dev": "yarn clean && yarn install && yarn dev",
    "re:build": "yarn clean && yarn install && yarn build",
    "re:build-npm": "npm run clean && npm install && npm run build",
    "tsc:dev": "yarn dev & yarn tsc:watch",
    "tsc:watch": "tsc --noEmit --watch",
    "tsc:print": "npx tsc --showConfig"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@iconify/react": "^6.0.2",
    "@mui/lab": "^7.0.0-beta.17",
    "@mui/material": "^7.3.2",
    "@mui/stylis-plugin-rtl": "^7.3.2",
    "@mui/x-data-grid": "^8.12.1",
    "@mui/x-date-pickers": "^8.12.0",
    "@mui/x-tree-view": "^8.12.0",
    "autosuggest-highlight": "^3.3.4",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "ethers": "^6.16.0",
    "framer-motion": "^13.4.4",
    "lightweight-charts": "^5.2.1",
    "minimal-shared": "^1.1.6",
    "nprogress": "^0.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^7.18.2",
    "recharts": "^3.10.1",
    "simplebar-react": "^3.3.2",
    "stylis": "^4.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/autosuggest-highlight": "^3.2.4",
    "@types/node": "^24.5.2",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stylis": "^4.2.7",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^2"
  },
  "resolutions": {
    "//": "Security pins for transitive dependencies (2026-08-06 audit, O-7). yarn-only: npm ignores this field, which is one more reason package-lock.json is not kept here. @swc/core is pinned to 1.13.5 (2026-09-30): the 1.16 native binding validates the ACL of %LOCALAPPDATA%/swc and fails to load on some Windows dev machines, aborting vite build/dev (swc-project/swc#12442). See docs/KNOWN_LIMITATIONS.md.",
    "rollup": "^4.62.4",
    "yaml": "^2.9.0",
    "cosmiconfig": "^8.3.6",
    "@swc/core": "1.13.5"
  }
}
