# ─────────────────────────────────────────────────────────────────────────────
# PepeLab Agent — 環境變數範例（Phase 4：全程 Base Sepolia 同鏈）
# 複製成 .env 後填入實際值：  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── 鏈上讀取（Base Sepolia, chainId 84532）──────────────────────────────────
# 合約部署在 Base Sepolia；位址由 frontend/src/contracts/addresses.ts 讀取，
# 此處只需提供一個 Base Sepolia RPC。可用 Alchemy / 官方 / 公共節點。
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# （選用）回退到舊的 Ethereum Sepolia 部署：設 AGENT_CHAIN_ID=11155111 + 此 RPC。
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# AGENT_CHAIN_ID=84532

# ── x402 付費結算（Base Sepolia — 官方 USDC）─────────────────────────────────
# x402-hono 以 "$價格" + network 自動解析成該網路的官方 USDC：Base Sepolia 上即
# Circle 官方測試 USDC（6-dec, EIP-3009 transferWithAuthorization）。
X402_NETWORK=base-sepolia
# facilitator 負責驗證 + 上鏈結算。可用 x402.org 測試 facilitator 或 CDP。
X402_FACILITATOR_URL=https://x402.org/facilitator
# x402 協定版本（docs/ADR-010-x402-v2-migration.md）。不設 = v1，行為與遷移前完全相同。
#   v1   ：X-PAYMENT／X-PAYMENT-RESPONSE，付款要求在 402 本文（x402-hono 0.5.3）。
#   both ：同一個端點 v1、v2 都收（過渡期用）。未付款的 402 本文不變，另帶 PAYMENT-REQUIRED header。
#   v2   ：只收 PAYMENT-SIGNATURE（@x402/core 2.x）；X-PAYMENT 不再被接受，舊 client 會付不了款。
# 無法辨識的值一律當成 v1（stderr 會有一行錯誤）。切換前先讀 ADR-010 的「切換步驟」。
# v2／both 需要 X402_NETWORK 對應得到 CAIP-2（base-sepolia、base，或直接寫 eip155:84532）；對應不到時
# 服務照常啟動、免費端點照常，但付費端點一律回 503 x402_misconfigured（啟動時 stderr 一行錯誤）。
# v2 結算結果未知（facilitator 逾時／5xx／settlement_pending）回 502 phase=settle，並寫進 Redis 的
# x402:settlement:unknown 由結算 worker 自動對帳；判不了的移到 x402:settlement:unknown:manual。
# X402_UNKNOWN_MAX=1000   # 該清單長度上限（滿了的紀錄完整寫入 manual、原因 overflow，並計入 x402:settlement:unknown:overflow）
# X402_RECONCILE_LOG_CHUNK=1000   # 對帳查 AuthorizationUsed 事件時每次 eth_getLogs 的區塊數，1–1000（公共 RPC 上限 1000）
# X402_PROTOCOL=v1
# v2 對 facilitator 單次請求（/supported、/verify、/settle）的逾時，毫秒，1000–55000；預設 20000。
# X402_FACILITATOR_TIMEOUT_MS=20000

# 收款地址 payTo。【必填】必須是 FEE_SETTLEMENT_PRIVATE_KEY 的 EOA 地址
# （worker 要用同一把金鑰 approve + routeExternalRevenue）。
#   - 不可用 Safe 或任何合約（包含 FeeRouter）；
#   - 不可用外洩地址（2026-08-06 稽核的舊 deployer，已被 EIP-7702 sweeper 接管）。
# signal-api 在發出 402 之前會檢查（外洩清單 / EIP-7702 委派 / 非 EOA → 503 payto_unsafe），
# 結算 worker 也會在碰佇列前檢查；未通過一律 fail-closed。
PAY_TO=
# （選用）額外的禁止收款地址，逗號分隔；與程式內建的 COMPROMISED_ADDRESSES 合併。
# PAYOUT_DENYLIST=
# /oracle 收入的 70% 受益人（trader 地址）。未設 → /oracle 收入不排入分潤（款項留在 PAY_TO），
# 回應會帶 settleError 說明原因。不可設成外洩地址。
ORACLE_BENEFICIARY_ADDRESS=

# ── x402 收入「真上鏈分潤」結算（Option 1：官方 USDC）───────────────────────
# 設定後，settlement-worker.ts（獨立於 server process，見下方佇列說明）批次呼叫
# 【x402 專用】FeeRouter.routeExternalRevenue 走 70/20/10（70% 歸該 trader）。
# 此 FeeRouter 綁官方 USDC，與永續引擎的 MockUSDC 分離。
# 流程：x402 付款 → treasury EOA 收官方 USDC → 佇列記帳 → worker 批次
# approve + routeExternalRevenue。
# ⚠ 此金鑰的地址 = PAY_TO（treasury EOA），需持官方 USDC + 少量 ETH。僅限測試錢包，
#   必須是**新產生**的金鑰（不可沿用任何曾外洩的 deployer 金鑰）。
# ⚠ 2026-09-17 起：本機跑 signal-api server 不再需要這把金鑰（server 只記帳）；
# 佇列只由 GitHub Actions 的 x402-settlement-worker.yml 結算（worker 只准在 CI 內執行，
# 本機會拒跑）；本機可用 `npx tsx signal-api/src/settlement-worker.ts --dry-run` 只讀檢視佇列。
FEE_SETTLEMENT_PRIVATE_KEY=
# x402 專用 FeeRouter（綁官方 USDC）。⚠ 目前部署的 0x29e5732AC62254d9b92A1C7d3F38EbFA8809B57d
# 的 platformTreasury（immutable）是外洩地址 → 結算 worker 的守門會拒跑。
# 需以新的 treasury 重新部署（DeployX402Router.s.sol）後把新位址填在這裡。
X402_FEE_ROUTER=0x29e5732AC62254d9b92A1C7d3F38EbFA8809B57d
# 結算 token（官方 Base Sepolia USDC, 6-dec）。
X402_SETTLEMENT_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ── x402 結算佇列（優先序 1：記帳 + 批次結算，2026-09-17）───────────────────
# 付費端點（/signals、/oracle）不再於請求內送鏈上交易，只把待分潤項目推進這個
# Upstash Redis 佇列（REST API，serverless 友善，見 signal-api/src/ledger.ts）。
# 兩個都沒設時：資料照樣回應，但 settleError 會點名缺這兩個 env（見 app.ts）。
# 免費額度：https://console.upstash.com 建一個 Redis database，用它的 REST URL/Token。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 真正把佇列送上鏈的是獨立的 settlement-worker.ts（見下方 FEE_SETTLEMENT_PRIVATE_KEY），
# 由 .github/workflows/x402-settlement-worker.yml 定期觸發，不是這個 server process。
# 下列三個全部有預設值，通常不需要覆寫：
# SETTLEMENT_BATCH_SIZE=25       每次 worker 執行最多處理幾筆（重試佇列另計）
# SETTLEMENT_MAX_RETRIES=5       失敗幾次後移進死信佇列（x402:settlement:dead）
# SETTLEMENT_MAX_FAIL_PCT=30     這次執行的失敗率超過幾 % 就讓 CI job 變紅
# SETTLEMENT_WAIT_TIMEOUT_MS=90000       等 receipt 的時限；逾時 → UNKNOWN（記 hash、絕不重送）
# SETTLEMENT_STUCK_AFTER_MS=1800000      UNKNOWN 超過這麼久仍查不到 receipt → STUCK，job 失敗交人工
# 結算 worker 會讀 SIGNAL_API_URL（見下方 Signal API server 區塊）的 GET /，確認線上公布的
# payTo = 結算 signer；不一致就拒跑。卡住的交易怎麼處理見 agent/README.md「結算交易卡住」。

# ERC-8126 驗證者簽章用金鑰（正式環境務必設，否則每次重啟 verifier DID 會變）
VERIFIER_PRIVATE_KEY=

# 領幣：Base Sepolia ETH（gas）+ 官方測試 USDC（付 x402）。
#   ETH  : https://docs.base.org/chain/network-faucets
#   USDC : https://faucet.circle.com  (選 Base Sepolia) 或 CDP faucet

# ── Signal API server ────────────────────────────────────────────────────────
SIGNAL_API_PORT=4021
SIGNAL_API_URL=http://localhost:4021

# ── Demo agent 錢包（自管 EOA，付 x402 費用用）──────────────────────────────
# 自管 EOA 私鑰，需在 Base Sepolia 持有測試 USDC + 少量 ETH 付 gas。
# Phase 2 會升級為 session key 委派；Phase 1 先用單一 EOA。
# ⚠️ 僅限測試錢包，切勿放入主錢包私鑰。
AGENT_PRIVATE_KEY=0xYOUR_TEST_EOA_PRIVATE_KEY

# demo agent 要分析的 trader（預設用 addresses 的 demo trader；可填任意已註冊地址）
DEMO_TRADER_ADDRESS=
# demo agent 要查的資產
DEMO_ASSET=sBTC

# ── Phase 2 自主下單（write path，經 AgentSessionManager）────────────────────
# AGENT_PRIVATE_KEY 在此同時當作 session key（自管 EOA / 委派金鑰），在 session
# 限額內代下單；永不持有使用者主錢包私鑰。下列三者齊備時，demo agent / MCP
# write tools 才會真的送鏈，否則優雅退化（只讀 + 印出「本來會下的單」）。
#
# AgentSessionManager 位址。Base Sepolia 已部署：填下方位址即可（或留空走 env）。
#
# 現行 manager（2026-09-29 更新）：綁現行 PerpetualExchange 0x827eA0c62a32e995927101259042F8A27D99124D。
# 來源：contracts/broadcast/Redeploy129Exchange.s.sol/84532/run-latest.json（AgentSessionManager）；
# 鏈上核對：exchange()==0x827eA0c62a32e995927101259042F8A27D99124D，且該 exchange 的 authorizedAgents(本 manager)==true。
# 舊的 0x4E7cC1B79B72ab72531a6C790e14304370f70764 綁的是已退役的 exchange 0xEf75…c072，
# 更舊的 0x5Ebcc64C… 沒有資產白名單——兩者都不要再用。
SESSION_MANAGER_ADDRESS=0xdF9C1E53523568709f65Afe3C4AD2E6a6D99d14B
# 使用者 createSession 後得到的 session id（demo agent / bot / autotrade 用它下單）。
#
# session id 是「每個 manager 各自獨立」的：現行 manager 上目前只有 #0
# （2026-09-29 鏈上讀 nextSessionId=1，到期 2027-07）。舊 manager 的 session id
# 在這裡無效。新建 session 用根目錄的 create-session.sh（會從 receipt 事件印出 id）。
DEMO_SESSION_ID=0
# 每筆下單保證金（USDC，≥ MIN_MARGIN=10），受 session.maxMarginPerTrade 約束
DEMO_MARGIN=10

# ── Track C：Telegram 交易 agent（agent/tg-bot）──────────────────────────────
# 從 BotFather 取得的 bot token
TELEGRAM_BOT_TOKEN=
# 【必填】允許下單的 Telegram chat id（多個以逗號分隔，群組為負數）。
# 稽核 2026-08-06 A-2：這裡以前寫「留空＝不限制」，而 bot 能用 session key 直接
# 上鏈開真倉 —— 留空等於把下單權開放給任何知道 bot 名稱的人。**未設會啟動失敗。**
# 取得方式：對 bot 傳一則訊息後開
#   https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# 取 message.chat.id。
TELEGRAM_ALLOWED_CHAT=
# 【必填】允許下單的 Telegram user id（message.from.id），逗號分隔。chat 白名單之外，
# 發訊者本人也必須在這裡——否則白名單群組的任何成員都能下單。未設會啟動失敗。
TELEGRAM_ALLOWED_USERS=
# 每人下單頻率上限（預設 10 分鐘 5 筆）。每筆下單另需 60 秒內 /confirm <確認碼>。
TG_RATE_MAX=5
TG_RATE_WINDOW_MS=600000
# tg-bot 的下單上界（第二道防線；合約 session cap 才是最終約束）
TG_MAX_LEVERAGE=5
TG_MAX_MARGIN=1000
TG_MIN_MARGIN=10
# 【必填給 tg-bot】使用者簽發的授權 VC（W3C VC JSON）路徑；下單前驗簽 + 鏈上 session
# 交叉比對。從前端 /sessions「Issue VC」匯出後存成此檔（預設 ./tg-bot/vc.json，已 gitignore）
AGENT_AUTH_VC_PATH=./tg-bot/vc.json

# ── Track D：x402 自主交易（examples/x402-autotrade.ts）──────────────────────
# 公開付費 API（x402 訊號）。
X402_API_URL=https://agent-git-master-zuemens-projects.vercel.app
# PerpetualExchange 位址（資訊用；下單經 SESSION_MANAGER_ADDRESS）。
# 現行 exchange，= frontend/src/contracts/addresses.ts BASE_SEPOLIA.PerpetualExchange。
PERP_ADDRESS=0x827eA0c62a32e995927101259042F8A27D99124D
# （可選）要買 /signals 的 trader 地址；留空＝用付款錢包自己的地址。
TRADER=
# ⚠ 跑 x402-autotrade 的 AGENT_PRIVATE_KEY 錢包必須持「官方 Base Sepolia USDC」
#   （Circle, EIP-3009，到 Circle 測試網水龍頭領）+ 一點 ETH 付 gas。
#   付款用官方 USDC，與平台模擬 USDT 保證金是兩種幣、用途不同。

# ── 授權閘門（稽核 A-3/A-4）─────────────────────────────────────────────────
# openPositionForSession / closePositionForSession 的 VC 驗證**預設必要**。
# 只有測試環境才把它設成 true（等同關閉授權層，下單將無法歸因到任何簽發者）。
AGENT_ALLOW_UNSIGNED_TRADES=false
# VC v2（verifyingContract + validUntil + nonce）的 nonce 一次性紀錄；重啟後仍有效。
# 預設 agent/.state/vc-nonces.json。舊格式 v1 VC 可用到 2026-12-31（UTC），之後拒絕。
# VC_NONCE_STATE_PATH=
# VC 撤銷（狀態清單，docs/ADR-016-vc-credential-status.md）。開倉／平倉前一律檢查；
# 被撤銷、拿不到或驗不過狀態 → 拒絕（fail-closed，沒有關閉開關）。全部可選：
#   VC_STATUS_URL                 清單目錄的 http(s) base URL（需有 index.json 目錄標記）；設了就不用本機目錄。
#                                 主機對缺檔必須直接回 404：回 403（例如 S3 未開 ListBucket）或轉址都算狀態不明 → 寫入拒絕
#   VC_STATUS_DIR                 本機清單目錄（預設 agent/.state/vc-status）。必須先跑
#                                 `npx tsx examples/vc-status.ts init` 建立 index.json 目錄標記，否則所有開倉／平倉都被拒；
#                                 清單以 examples/vc-status.ts install 放入，`expiring --days 7` 排程檢查快到期的清單
#   VC_STATUS_STATE_PATH          驗證端狀態（最高 sequence、看過的撤銷；預設 agent/.state/vc-status-state.json）
#   VC_STATUS_CACHE_MAX_AGE_SEC   清單快取新鮮度上限（預設 60，最大 900）
#   VC_STATUS_READ_POLICY         唯讀動作遇到狀態未知：allow（預設，放行並標 unknown）｜deny
# VC_STATUS_URL=
# VC_STATUS_DIR=

# ── Policy gate（shared/src/policyGate.ts；送交易前無條件執行，無 opt-out）──────
# 全部可選；不設＝保守預設。設定不合法 → 一律拒絕下單（fail-closed）。
# POLICY_GATE_CONFIG_PATH=./policy.json   # JSON（部分欄位即可），個別 env 再覆寫它
POLICY_MAX_MARGIN_PER_TRADE=100          # 單筆保證金上限（USDC）
POLICY_MAX_DAILY_MARGIN=500              # 每位客戶（agent, 鏈上 session.user）每個 UTC 日的累計開倉保證金上限
POLICY_AGENT_MAX_DAILY_MARGIN=2000       # agent 全域（所有客戶合計）每個 UTC 日的累計開倉保證金上限
POLICY_AGENT_MAX_ORDERS_PER_WINDOW=40    # agent 全域（所有客戶合計）時間窗內最多開倉筆數
POLICY_MAX_LEVERAGE=5                    # 槓桿上限
POLICY_MAX_ORDERS_PER_WINDOW=10          # 時間窗內最多開倉筆數
POLICY_MAX_CLOSES_PER_WINDOW=60          # 平倉獨立的寬鬆桶（平倉不計入、不受開倉頻率與額度限制）
# 狀態檔壞／稽核寫不進去：開倉拒絕（fail-closed），平倉放行（OK_DEGRADED＋::error::）
POLICY_WINDOW_SEC=3600                   # 時間窗（秒）
# POLICY_ALLOWED_ASSETS=sBTC,sETH        # 允許資產；不設＝協議上架的全部資產
# POLICY_STATE_PATH=                     # 預設 agent/.state/policy-state.json（三個進入點共用）
# POLICY_AUDIT_PATH=                     # 預設 agent/audit/policy-gate.jsonl（hash-chained）

# ── MCP 寫入工具的人類確認（mcp-server/src/writeTools.ts）───────────────────
# 預設開啟：open_position / close_position 送出前以 MCP elicitation 在 client 介面詢問人類
# （答案不經模型）；client 不支援 elicitation 時一律拒絕寫入。
# 只有明確設成 false 才關閉（啟動與每次寫入都會在 stderr 警告）。
MCP_WRITE_REQUIRE_CONFIRM=true

# ── x402-loop 的花費/輪數上限（稽核 四·Medium）───────────────────────────────
# 舊版 for(;;) 無限輪、每資產先付費再判斷（192 次付費/日、無累計上限）。
# 累計 x402 資料費上限（USDC）：所有 x402 付款流程共用，簽章守門在簽出每筆授權前檢查（本 process 累計）。
# 舊名 LOOP_MAX_SPEND_USDC 仍可用。
X402_MAX_TOTAL_SPEND_USDC=1
# x402 收款地址 allowlist（逗號分隔）。不設 → 用 PAY_TO；都沒有 → 以第一次付款的收款地址為準（TOFU）。
# X402_PAYTO_ALLOWLIST=0x…
# x402 client 單筆付款上限（USDC）。所有 wrapFetchWithPayment 都明確傳入；
# 不設 = 0.02（x402-fetch 套件預設是 0.10）。伺服器要求更高就拒付。
X402_MAX_PAYMENT_USDC=0.02
# x402 付款授權有效期上限（秒）：簽章守門拒絕 validBefore > now + 這個值的授權。
# 不設 = 300（signal-api 宣告 maxTimeoutSeconds=60；x402-hono 未設定時預設 300）；最多 3600，格式錯誤 fail-closed。
# X402_MAX_VALIDITY_SEC=300
# 簽章白名單（shared/src/signingGuard.ts）：agent 金鑰只能簽 session manager 的開倉／平倉、
# 官方 USDC 的 x402 付款（單筆 ≤ X402_MAX_PAYMENT_USDC）、ERC-8126 持有證明訊息。
SIGNING_GUARD_MAX_TX_VALUE_WEI=1000000000000000   # 開倉附帶的 ETH 上限（executionFee 等級，預設 0.001 ETH）
LOOP_MAX_ROUNDS=0          # 0 = 不限輪數
LOOP_MAX_FAILURES=5        # 連續整輪失敗上限，超過即退出
X402_ORACLE_PRICE=0.005    # 與 server 的 PRICE_ORACLE 一致（用於累計花費）

# ── Keeper 偏離守衛（稽核 A-5）──────────────────────────────────────────────
# MockOracle 是交易所實際結算/清算所讀的那顆，鏈上沒有任何保護，
# 因此「數值合法但離譜」的來源價格必須在 keeper 端就被拒寫（熔斷語意：只寫完整
# 價格或不寫，絕不寫部分步進）。見 docs/RUNBOOK_KEEPER.md「價格熔斷」。
KEEPER_BREAKER_DEVIATION=0.2    # 單源變動超過此幅度 → 需多源確認，否則拒寫並讓 job 失敗
KEEPER_CONFIRM_TOLERANCE=0.02   # 多源確認：獨立來源彼此最大差距
KEEPER_MAX_DEGRADED_RATIO=0.3   # 無法更新的資產比例超過此值 → CI 變紅

# ── 金庫儲備觀測（#99）─────────────────────────────────────────────────────
# 選用。設定後 keeper 在每輪價格寫完後呼叫 AssetVaultV2(.3+).observeReserve()，
# 讓儲備率變成可重播的 ReserveObserved 事件時間序列；破線時自動暫停 mint()
# （redeem 不受影響）。不設就完全跳過，不影響喂價本身。
KEEPER_VAULT_ADDRESS=

# ── Signal API 的 CORS / 節流 / SSRF 防護（稽核 四·Low/Medium）──────────────
# POST /demo/* 允許的來源（GET 資料端點仍對所有來源開放）。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://pepelab-onchain-cfd-djot.vercel.app
# 免費端點 per-IP 節流（best-effort，serverless 上是 per-instance）。
FREE_RATE_WINDOW_MS=60000
FREE_RATE_MAX=60
# /candles 快取上限（LRU 筆數）。鍵含使用者可控的 limit/end，必須有上界。
CANDLE_CACHE_MAX=500
# ERC-8126 的 WAV 自我檢查會對「這個 API 的公開網址」發外連請求。缺
# SIGNAL_API_PUBLIC_URL 時，只有這個白名單裡的 origin 會被信任（否則請求帶進來的
# Host header 就成了未認證的 SSRF 放大器）。
SIGNAL_API_PUBLIC_URL=
SIGNAL_API_URL_ALLOWLIST=
# ERC-8126 attestation 有效期（秒），過期即失效（防重放）。
AGENT_ATTESTATION_TTL=900

# ── x402 KYA（Know Your Agent，docs/SSI_AGENT_DELEGATION.md）──────────────────
# 預設 off：付費端點行為與加入 KYA 前相同。on：付款時必須附 X-Agent-Presentation（v3 委託憑證）。
# 只接受 on／off；其他值（true、1…）視為設定錯誤，付費端點一律 503。
# X402_KYA_MODE=off
# 錨定要求：required（預設）｜optional｜off
# X402_KYA_ANCHOR=required
# SessionCredentialAnchor 位址（contracts/script/DeploySessionCredentialAnchor.s.sol）。
# 代理人的寫入路徑也讀它：有設時，v3 委託憑證開倉前必須仍被 session 使用者錨定（平倉不受影響）。
# SESSION_ANCHOR_ADDRESS=
# 讀 session／錨定的 RPC（預設與 signal-api 相同）
# KYA_RPC_URL=
# 接受的 DID 鏈（逗號分隔；預設 AGENT_CHAIN_ID 與 84532）
# DELEGATION_VC_CHAIN_IDS=
# presentation 時間容忍秒數（預設 120，上限 600）
# X402_KYA_MAX_SKEW_SEC=120
# 每個 IP 在視窗內的 KYA 驗證失敗上限（超過 → 429）
# KYA_FAIL_MAX=20
# KYA_FAIL_WINDOW_MS=60000
