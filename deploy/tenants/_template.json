{
  "$comment": "租戶部署設定範本。複製成 deploy/tenants/<tenant-id>.json 後填寫；說明見 docs/TENANT_DEPLOYMENT.md。這個檔案只放佔位值與環境變數名稱，任何私鑰、助記詞、RPC 網址都不得寫進來（node scripts/check-tenant-deploy.mjs 會擋）。",
  "schemaVersion": 4,
  "tenantId": "<TENANT_ID>",
  "status": "template",
  "frontendTenant": "<TENANT_ID>",
  "network": {
    "chainId": 84532
  },
  "secretsEnv": {
    "deployerPrivateKey": "TENANT_DEPLOYER_PRIVATE_KEY",
    "keeperPrivateKey": "TENANT_KEEPER_PRIVATE_KEY",
    "rpcUrl": "BASE_SEPOLIA_RPC_URL"
  },
  "roles": {
    "admin": "<ADMIN_MULTISIG_ADDRESS>",
    "risk": "<RISK_ADDRESS>",
    "guardian": "<GUARDIAN_ADDRESS>",
    "keeper": "<KEEPER_ADDRESS>",
    "marketOperator": "<MARKET_OPERATOR_ADDRESS>",
    "treasury": "<TENANT_TREASURY_ADDRESS>"
  },
  "shared": {
    "settlementToken": "<SETTLEMENT_TOKEN_ADDRESS>",
    "priceSource": "<REFERENCE_PRICE_SOURCE_ADDRESS>",
    "referenceSource": "<ORACLE_REFERENCE_SOURCE_ADDRESS>"
  },
  "params": {
    "oracleKind": "guarded",
    "oracleMaxDeviationBps": 1000,
    "oracleWindowSeconds": 3600,
    "oracleWindowDeviationBps": 2500,
    "oiCapNonRwaUsdc": null,
    "oiCapRwaUsdc": null,
    "maxProfitBps": null,
    "maxLeverage": null,
    "liquidationPenaltyBps": 2000,
    "markPremiumCapBps": 0,
    "vaultFeeShareBps": 0,
    "deployVault": true,
    "vaultRedeemFeeBps": 30,
    "vaultMinReserveRatioBps": 11000,
    "kycRegistry": "allowlist"
  },
  "assets": {
    "registered": ["sAAPL", "sMSFT", "sGOLD", "sBOND"],
    "additionalRwa": []
  },
  "fees": {
    "status": "pending-decision",
    "baseFeeBps": null,
    "tenantMarkupBps": null
  },
  "keeper": {
    "cron": "*/15 * * * *"
  }
}
